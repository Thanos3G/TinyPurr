# Build output
.pio
# Generated by ESP-IDF from sdkconfig.defaults on every build.
firmware/sdkconfig.*
!firmware/sdkconfig.defaults
# PlatformIO writes these itself for an espidf project when they are missing.
firmware/CMakeLists.txt
firmware/src/CMakeLists.txt
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Superseded: earlier datasets, model versions and one-off scripts, kept on
# disk because some of it is not cheaply reproducible, but out of the repo.
old/

# Training data and the archive it comes from. Rebuilt by
# dataset/build_gsc_dataset.py, and the archive is one download away.
gsc/
gsc_set/
*.tar.gz
*.log
*.wav

# Model libraries as downloaded from Edge Impulse. The one in use is committed
# under lib/ so the firmware builds from a clean checkout.
*.zip

# Enclosure: only the readme is public. The design is still changing, and the
# STL exports, the OpenSCAD source and the fit report all stay local.
enclosure/*
!enclosure/README.md
*.stl

# Camera originals and demo footage. The photos used by the readme live in
# media/photos and are committed; these are the unedited sources, hundreds of
# megabytes of them, and the repo does not need to carry them.
newpictures/
videos/
