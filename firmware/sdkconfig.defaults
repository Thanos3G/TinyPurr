# ESP-IDF configuration. Under framework = arduino these settings came from a
# frozen sdkconfig.h that Espressif ships prebuilt, selected by
# board_build.arduino.memory_type. ESP-IDF generates its own, so they are
# stated here instead.

# The Arduino core runs as an IDF component, so setup()/loop() need starting.
CONFIG_AUTOSTART_ARDUINO=y

# 240 MHz, which is what Arduino's prebuilt config ran at. ESP-IDF defaults to
# 160, and at 160 the speaker is white noise: the sounds are synthesized into
# the PDM buffers a block at a time while inference runs on the other core, and
# there is not enough headroom to keep the DMA fed.
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# Arduino's prebuilt IDF is built at 1000 Hz. The IDF default of 100 Hz would
# quantise every millis()-based timing in the firmware to 10 ms steps.
CONFIG_FREERTOS_HZ=1000

# -Os, matching the prebuilt Arduino libraries. Not cosmetic: at -O2 gcc 8.4.0
# hits an internal compiler error in the Edge Impulse MFCC code
# (dsp/speechpy/feature.hpp, mfe_v3, "insn does not satisfy its constraints").
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# 8 MB octal PSRAM. mic.cpp, main.cpp and ei_alloc.cpp all allocate with
# MALLOC_CAP_SPIRAM and get NULL without this.
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# Warnings and above only. At the IDF default of INFO the ADC driver logs a
# gpio line on every battery read, which is once every frame, and the console
# is unreadable.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# 16 MB QIO flash.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
